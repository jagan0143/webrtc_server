# Server port (5000 is taken by AirPlay on macOS, so 5050 is the default)
PORT=5050

# MongoDB Atlas connection string: Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webrtc_calls?retryWrites=true&w=majority

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173,https://webrtc-client-sand.vercel.app

# How long an unanswered call rings before it becomes a missed call
RING_TIMEOUT_MS=30000

# ICE servers. STUN is enough on the same network; add TURN for calls across the internet.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Web Push (incoming-call notifications). Generate once with: npx web-push generate-vapid-keys
# Use the same keys everywhere the server runs; changing them invalidates every device's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How long a call rings when the callee was woken by a push notification (opening the app takes time)
PUSH_RING_TIMEOUT_MS=45000

# How long an ongoing call survives one side's connection dropping (e.g. a quick app switch on a phone)
CALL_RECONNECT_GRACE_MS=20000
